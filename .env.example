# ── WhereCtx configuration ─────────────────────────────────────────────
# Copy to `.env` and adjust. Every value shown is the default the server uses
# when the variable is unset. src/config.test.ts fails if this file and
# src/config.ts disagree on the variable names.

# ── HTTP server ────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# The address people and phones use to reach this server. Passkeys are bound
# to its host name, so open the dashboard at exactly this origin. Browsers
# allow passkeys only on https or on localhost, so http://192.168.x.x does not
# work. Device pairing also needs it to be a public https URL.
BASE_URL=http://localhost:8787

# Which proxy header names the client for rate limiting: none | cloudflare | xff.
# none uses the TCP peer address. Set cloudflare only when every request arrives
# through Cloudflare (Tunnel), and xff only behind a proxy that sets
# X-Forwarded-For. Otherwise clients can spoof the header.
TRUST_PROXY=none

# Database. Accepts:
#   file:./data/wherectx.db                (libsql / local file)
#   sqlite:////data/wherectx.db            (docker-compose style, normalized)
DATABASE_URL=file:./data/wherectx.db

# ── Identity ───────────────────────────────────────────────────────────
# The first person. This user owns the bootstrap tokens below, the privacy
# settings row seeded at boot, and the first passkey registered with the
# setup code. On an install upgraded from v0.1 it is the user that owns the
# existing data. Changing it after first boot does not move data or tokens.
USER_ID=default
# Whether anyone signed in may create workspaces. When false, only USER_ID and
# people who own or administer a workspace may.
ALLOW_MEMBER_WORKSPACES=true

# ── Bootstrap tokens (optional) ────────────────────────────────────────
# Seeded for USER_ID at boot. Leave them empty and make tokens in the dashboard
# (Agents, Devices) instead. Values starting with change-me or shorter than 24
# characters are refused. If USER_ID ends up with no admin token, the server
# generates one and prints it once.
ADMIN_TOKEN=
DEVICE_TOKEN=
AGENT_TOKEN=

# ── Privacy and policy ─────────────────────────────────────────────────
# These seed each person's privacy settings the first time they are read.
# After that the dashboard's Privacy screen is authoritative.
# What agents see by default: hidden | coarse | precise
DEFAULT_AGENT_PRIVACY=coarse
# Require a `reason` when an agent asks for the precise location.
PRECISE_REQUIRES_REASON=true
# Allow agents to read the precise location at all.
ALLOW_PRECISE_TO_AGENT=false
# Refuse exact coordinates while you are at or near home. New location shares
# with people also start with home hidden when this is on.
HIDE_HOME_EXACT_COORDINATES=true
# Creating or changing the `home` place over MCP needs the manage_places scope.
PROTECT_HOME_PLACE=true
# Hours of raw location history to keep (only when STORE_RAW_HISTORY=true).
RETENTION_HOURS=24
# Store raw lat/lon history. Off by default.
STORE_RAW_HISTORY=false
# Seconds until a reading counts as stale. Server-wide, not a per-person
# setting. Each reading keeps the value it was stored with.
STALE_AFTER_SEC=900

# ── Geofence ───────────────────────────────────────────────────────────
# Multiple of a place's radius that still counts as "near" (near_home). >= 1.
NEAR_RADIUS_MULTIPLIER=3

# ── Webhooks ───────────────────────────────────────────────────────────
# Allow delivery to private or reserved IPs (loopback, RFC1918, cloud
# metadata). Off to prevent SSRF. Turn on only to reach a LAN service such as
# a local Home Assistant.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Key that encrypts webhook signing secrets at rest (AES-256-GCM). When set,
# plaintext secrets are encrypted on boot. When unset, secrets are stored as
# plaintext and boot logs a warning. Generate with: openssl rand -hex 32
#WEBHOOK_ENCRYPTION_KEY=

# ── MCP OAuth ──────────────────────────────────────────────────────────
# Let MCP clients register themselves at /oauth/register (dynamic client
# registration). Clients identified by a Client ID Metadata Document need no
# registration, so leave this off unless a client requires it.
OAUTH_DYNAMIC_REGISTRATION=false

# ── Retention ──────────────────────────────────────────────────────────
# Hours to keep presence events and webhook dead letters. Minimum 1.
# 720 = 30 days.
EVENT_RETENTION_HOURS=720
# Days to keep each person's share audit (grants, changes, revokes, and who
# viewed their precise location). Minimum 1.
SHARE_AUDIT_RETENTION_DAYS=365
