# ── WhereCtx NAS configuration ──────────────────────────────────────────────
# Copy to `.env` in the same folder as docker-compose.nas.yml and adjust.
# This file is tailored for a Synology NAS + Cloudflare Tunnel deployment.
# All values shown are safe defaults; tokens marked "change-me" MUST be changed.

# HTTP server — port is internal only; no LAN port is published.
PORT=8787
HOST=0.0.0.0

# Public base URL exposed through the Cloudflare Tunnel.
BASE_URL=https://wherectx.example.com

# Database — Docker named volume mounted at /data inside the container.
DATABASE_URL=sqlite:////data/wherectx.db

# ── Tokens ───────────────────────────────────────────────────────────────────
# Bootstrap tokens seeded into the store on first run.
# Use long random strings: openssl rand -hex 32
ADMIN_TOKEN=change-me-admin
DEVICE_TOKEN=change-me-device
AGENT_TOKEN=change-me-agent

# ── Identity ─────────────────────────────────────────────────────────────────
# Owner of the bootstrap tokens and of the privacy settings row seeded at boot.
# Each request acts as the user who owns its token. Changing this after first
# boot does not move existing data or tokens to the new id.
USER_ID=default

# ── Privacy / policy ─────────────────────────────────────────────────────────
# Default privacy exposed to agents: hidden | coarse | precise
DEFAULT_AGENT_PRIVACY=coarse
# Require a `reason` when an agent requests precise location.
PRECISE_REQUIRES_REASON=true
# Allow agents to read precise location at all (static policy gate).
ALLOW_PRECISE_TO_AGENT=false
# Hide exact home coordinates even when precise access is granted.
HIDE_HOME_EXACT_COORDINATES=true
# How long until a presence reading is considered stale (seconds).
STALE_AFTER_SEC=900
# Retain raw location history for this many hours (only if STORE_RAW_HISTORY=true).
RETENTION_HOURS=24
# Persist raw lat/lon history. Off by default (presence-first philosophy).
STORE_RAW_HISTORY=false
# When true, creating or overwriting a place named 'home' via MCP requires the
# admin (manage_places) scope. Prevents accidental overwrite of the home anchor.
# Toggleable from the dashboard without a restart.
PROTECT_HOME_PLACE=true

# ── Geofence ─────────────────────────────────────────────────────────────────
# Multiplier on a place radius that still counts as "near" (e.g. near_home).
NEAR_RADIUS_MULTIPLIER=3

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Allow webhook delivery to private/reserved IPs (loopback, RFC1918, cloud
# metadata, etc.). OFF by default to prevent SSRF. Set true ONLY if you
# deliberately point webhooks at a LAN service (e.g. Home Assistant on the
# same Docker network).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# AES-256-GCM key for encrypting webhook signing secrets at rest (optional).
# When set, any plaintext secrets in the store are auto-encrypted on boot.
# When unset, secrets are stored as plaintext and a startup warning is logged.
# Generate with: openssl rand -hex 32
#WEBHOOK_ENCRYPTION_KEY=

# ── Events ───────────────────────────────────────────────────────────────────
# How long to retain presence events and webhook dead-letters (hours).
# Events older than this are pruned periodically. Minimum 1h. Default 720 = 30 days.
EVENT_RETENTION_HOURS=720

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from the Cloudflare Zero Trust dashboard (Tunnels → your tunnel → Token).
CF_TUNNEL_TOKEN=change-me-cf-tunnel-token
