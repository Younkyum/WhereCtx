# ── WhereCtx NAS configuration ──────────────────────────────────────────────
# Copy to `.env` in the same folder as docker-compose.nas.yml and fill in
# BASE_URL and CF_TUNNEL_TOKEN. Every other value shown is the default the
# compose file uses when the line is missing. See ../.env.example for what
# each setting does.

# Public https URL of the Cloudflare Tunnel hostname. Passkeys are bound to
# this host name, so open the dashboard at exactly this address.
BASE_URL=https://wherectx.example.com

# Token from Cloudflare Zero Trust (Networks, Tunnels, your tunnel, Token).
CF_TUNNEL_TOKEN=change-me-cf-tunnel-token

# Every request arrives through the tunnel, so the client address is the
# cf-connecting-ip header.
TRUST_PROXY=cloudflare

# The image listens on 8787 on all interfaces, and cloudflared connects to
# wherectx:8787. The compose file does not pass these through.
#PORT=8787
#HOST=0.0.0.0
# Docker named volume mounted at /data. Fixed in the compose file.
#DATABASE_URL=sqlite:////data/wherectx.db

# ── Identity ─────────────────────────────────────────────────────────────────
USER_ID=default
ALLOW_MEMBER_WORKSPACES=true

# ── Bootstrap tokens (optional) ──────────────────────────────────────────────
# Leave empty and make tokens in the dashboard. To seed them, use long random
# strings: openssl rand -hex 32
ADMIN_TOKEN=
DEVICE_TOKEN=
AGENT_TOKEN=

# ── Privacy and policy ───────────────────────────────────────────────────────
DEFAULT_AGENT_PRIVACY=coarse
PRECISE_REQUIRES_REASON=true
ALLOW_PRECISE_TO_AGENT=false
HIDE_HOME_EXACT_COORDINATES=true
PROTECT_HOME_PLACE=true
RETENTION_HOURS=24
STORE_RAW_HISTORY=false
STALE_AFTER_SEC=900

# ── Geofence ─────────────────────────────────────────────────────────────────
NEAR_RADIUS_MULTIPLIER=3

# ── Webhooks ─────────────────────────────────────────────────────────────────
# Set true only to deliver webhooks to a LAN service such as Home Assistant.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Encrypts webhook signing secrets at rest. Generate with: openssl rand -hex 32
#WEBHOOK_ENCRYPTION_KEY=

# ── Retention ────────────────────────────────────────────────────────────────
EVENT_RETENTION_HOURS=720
SHARE_AUDIT_RETENTION_DAYS=365
