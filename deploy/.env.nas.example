# Copy to `.env` in the same folder as docker-compose.nas.yml on the NAS.
# Generate strong tokens, e.g.:  openssl rand -base64 24 | tr -d '/+='

# Your public WhereCtx URL (the Cloudflare Tunnel public hostname).
BASE_URL=https://wherectx.yourdomain.com

# WhereCtx tokens (long random strings — NOT "change-me-*").
ADMIN_TOKEN=replace-with-strong-random-admin
DEVICE_TOKEN=replace-with-strong-random-device
AGENT_TOKEN=replace-with-strong-random-agent

# Cloudflare Tunnel token (from the Zero Trust dashboard, "Docker" install tab).
CF_TUNNEL_TOKEN=eyJ...your-tunnel-token...
