{
  "name": "wherectx",
  "version": "0.1.0",
  "description": "Self-hosted real-world presence context layer for AI agents (MCP + REST).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wherectx": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "keywords": [
    "mcp",
    "presence",
    "location",
    "geofence",
    "ai-agents",
    "self-hosted",
    "privacy"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "ngeohash": "^0.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
