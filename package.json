{
  "name": "wherectx",
  "version": "0.1.0",
  "description": "Self-hosted real-world presence context layer for AI agents (MCP + REST).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12 || >=24"
  },
  "bin": {
    "wherectx": "dist/index.js",
    "wherectx-admin": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && vite build -c web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "reset-access": "tsx --env-file-if-exists=.env src/cli.ts reset-access"
  },
  "keywords": [
    "mcp",
    "presence",
    "location",
    "geofence",
    "ai-agents",
    "self-hosted",
    "privacy"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "ngeohash": "^0.6.3",
    "oidc-provider": "^9.12.2",
    "qrcode": "1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.1",
    "@astryxdesign/theme-neutral": "0.7.1",
    "@fontsource/figtree": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "@types/leaflet": "1.9.22",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^25.9.1",
    "@types/oidc-provider": "9.12.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "happy-dom": "21.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "^4.1.8"
  }
}
